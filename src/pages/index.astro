---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { projects } from '../data/projects';
import { site } from '../data/playbook';

const journal = projects.filter((p) => !p.featuredWorld);
const worlds = projects.filter((p) => p.featuredWorld);
---

<BaseLayout
  title="Tim Nakhapetov"
  description="Indie developer. Small apps I shipped, and notes on how it was done — including the Indie Launch Playbook."
  canonicalPath="/"
  ogImage="/og-home.png"
>
  <section class="page-hero">
    <div class="container">
      <p class="margin-note">Hub · indie builder</p>
      <h1 class="hero-brand">{site.name}</h1>
      <h2 class="hero-title" data-word-reveal>
        I build small apps. Then I write down how it was done.
      </h2>
      <p class="lede">
        Indie developer. Everything here is something I shipped, charged for, or learned the hard way.
      </p>
      <p class="updated">Updated Nov 2026</p>
      <div class="cta-row">
        <a class="btn btn-primary" href="#projects">See projects</a>
        <a href="/playbook" style="font-family: var(--font-mono); font-size: 0.85rem;">
          Read the free chapter →
        </a>
      </div>
    </div>
  </section>

  <hr class="rule container" />

  <section class="section" id="projects" aria-labelledby="projects-heading">
    <div class="container">
      <p class="margin-note">Log entries</p>
      <h2 class="section-title" id="projects-heading">Projects</h2>

      {worlds.map((project, i) => <ProjectCard project={project} index={i} />)}

      <div class="journal" style="margin-top: 2rem;">
        {
          journal.map((project, i) => (
            <ProjectCard project={project} index={worlds.length + i} />
          ))
        }
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="about-heading">
    <div class="container">
      <p class="margin-note">Note · author</p>
      <h2 class="section-title" id="about-heading">About</h2>
      <p class="lede">
        I'm Tim. I build apps with AI tools and run them like small businesses. This site is where the projects live.
      </p>
    </div>
  </section>
</BaseLayout>
