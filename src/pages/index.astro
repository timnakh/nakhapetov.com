---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { projects } from '../data/projects';
import { site } from '../data/playbook';
import { milestones } from '../data/log';
import { figNumbersForPage } from '../data/proof';

const journal = projects.filter((p) => !p.featuredWorld);
const worlds = projects.filter((p) => p.featuredWorld);
const figs = figNumbersForPage('playbook');
---

<BaseLayout
  title="Tim Nakhapetov"
  description="Indie developer. Small apps I shipped, and notes on how it was done — including the Indie Launch Playbook."
  canonicalPath="/"
  ogImage="/og-home.png"
>
  <section class="page-hero">
    <div class="container hero-split">
      <div class="hero-copy">
        <p class="hero-caption">{site.name}</p>
        <h1 class="hero-title" data-word-reveal>
          I build small apps. Then I write down how it was done.
        </h1>
        <p class="lede">
          Indie developer. Everything here is something I shipped or learned the hard way.
        </p>
        <p class="updated">Updated Nov 2026</p>
        <div class="cta-row">
          <a class="btn btn-primary" href="#projects">See projects</a>
          <a href="/playbook" class="text-link">Read the free chapter →</a>
        </div>
      </div>

      <aside class="hero-log" aria-labelledby="hero-log-heading">
        <p class="margin-note" id="hero-log-heading">Log</p>
        <ol class="milestone-log">
          {
            milestones.map((m) => {
              const figN = m.fig ? figs[m.fig] : undefined;
              return (
                <li>
                  <span class="milestone-date">{m.date}</span>
                  <span class="milestone-event">
                    {m.href ? (
                      <a href={m.href} rel="noopener noreferrer" target="_blank">
                        {m.event}
                      </a>
                    ) : (
                      m.event
                    )}
                    {figN ? (
                      <>
                        {' '}
                        <a class="fig-ref" href={`/playbook#evidence`}>
                          Fig. {figN}
                        </a>
                      </>
                    ) : null}
                  </span>
                </li>
              );
            })
          }
        </ol>
      </aside>
    </div>
  </section>

  <hr class="rule container" />

  <section class="section" id="projects" aria-labelledby="projects-heading">
    <div class="container">
      <p class="sr-only">Log entries</p>
      <h2 class="section-title" id="projects-heading">Projects</h2>

      {worlds.map((project, i) => <ProjectCard project={project} index={i} />)}

      <div class="journal" style="margin-top: 2rem;">
        {
          journal.map((project, i) => (
            <ProjectCard project={project} index={worlds.length + i} />
          ))
        }
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="about-heading">
    <div class="container">
      <p class="margin-note">Note · author</p>
      <h2 class="section-title" id="about-heading">About</h2>
      <p class="lede">
        I'm Tim. I build apps with AI tools and run them like small businesses. This site is where the projects live.
      </p>
    </div>
  </section>
</BaseLayout>
