<BaseLayout
  title="Chapter 1. Identity and entity · The Indie Launch Playbook"
  description="Settle your legal identity, D-U-N-S, bank account and business email before you apply anywhere. Free chapter from The Indie Launch Playbook."
  canonicalPath="/playbook/chapter-1"
