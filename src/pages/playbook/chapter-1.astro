---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Free chapter · The Indie Launch Playbook"
  description="Free chapter stub — full text will be published here."
  canonicalPath="/playbook/chapter-1"
  ogImage="/og-playbook.png"
>
  <section class="page-hero">
    <div class="container prose-narrow">
      <p class="eyebrow">Free chapter</p>
      <h1 class="hero-title" style="font-size: clamp(2rem, 5vw, 3.5rem); max-width: 16ch;">
        Chapter 1 — coming soon
      </h1>
      <p class="lede">
        This page is a stub. The free chapter text will be published here when the owner provides the file.
      </p>
      <p class="muted">
        If you confirmed your email, you will also receive the chapter by mail once sending is configured.
      </p>
      <div class="cta-row">
        <a class="btn btn-ghost" href="/playbook">Back to the playbook</a>
      </div>
    </div>
  </section>
</BaseLayout>
