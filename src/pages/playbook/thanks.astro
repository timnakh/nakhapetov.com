---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { playbook } from '../../data/playbook';
---

<BaseLayout
  title="You're in"
  description="Subscription confirmed. Here is your free chapter of the Indie Launch Playbook."
  canonicalPath="/playbook/thanks"
  ogImage="/og-playbook.png"
>
  <section class="page-hero">
    <div class="container prose-narrow">
      <p class="margin-note">Confirmed</p>
      <h1 class="hero-title" style="max-width: 12ch;">You're on the list</h1>
      <p class="lede">
        Thanks for confirming. Your free chapter is ready. You can also signal demand for the full playbook — no purchase on this page.
      </p>
      <div class="cta-row">
        <a class="btn btn-primary btn-large" href={playbook.freeChapterPath}
          >Read the free chapter</a
        >
      </div>
      <div class="cta-row" data-thanks-early-wrap hidden>
        <a
          class="btn btn-primary btn-large"
          href="/playbook/early-access"
          data-thanks-early
          data-event="early_access_click"
          data-source="thanks"
        >
          Get early access to the full playbook
        </a>
      </div>
      <p class="thanks-note">
        A welcome email is on the way with the same early-access link. Check spam if it does not arrive in a few minutes.
      </p>
      <div class="cta-row">
        <a class="btn btn-ghost" href="/playbook">Back to the playbook</a>
      </div>
    </div>
  </section>
</BaseLayout>

<script is:inline>
  (function () {
    var params = new URLSearchParams(window.location.search);
    var token = (params.get('t') || '').trim();
    var wrap = document.querySelector('[data-thanks-early-wrap]');
    var link = document.querySelector('[data-thanks-early]');
    if (token && wrap && link) {
      link.setAttribute('href', '/playbook/early-access?t=' + encodeURIComponent(token));
      wrap.removeAttribute('hidden');
    }

    var tries = 0;
    function tick() {
      if (window.posthog && typeof window.posthog.capture === 'function') {
        window.posthog.capture('subscribe_confirmed', { site: 'hub' });
        return;
      }
      if (tries++ < 50) setTimeout(tick, 100);
    }
    tick();
  })();
</script>
