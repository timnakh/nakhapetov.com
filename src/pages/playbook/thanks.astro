---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { playbook } from '../../data/playbook';
---

<BaseLayout
  title="You're in"
  description="Subscription confirmed. Here is your free chapter of the Indie Launch Playbook."
  canonicalPath="/playbook/thanks"
  ogImage="/og-playbook.png"
>
  <section class="page-hero">
    <div class="container prose-narrow">
      <p class="margin-note">Confirmed</p>
      <h1 class="hero-title" style="max-width: 12ch;">You're on the list</h1>
      <p class="lede">
        Thanks for confirming. Your free chapter is ready. The welcome email has a link if you want early access to the full playbook.
      </p>
      <div class="cta-row">
        <a class="btn btn-primary btn-large" href={playbook.freeChapterPath}
          >Read the free chapter</a
        >
      </div>
      <p class="thanks-note">
        Check your spam folder if the email does not arrive in a few minutes.
      </p>
      <div class="cta-row">
        <a class="btn btn-ghost" href="/playbook">Back to the playbook</a>
      </div>
    </div>
  </section>
</BaseLayout>

<script is:inline>
  (function () {
    var tries = 0;
    function tick() {
      if (window.posthog && typeof window.posthog.capture === 'function') {
        window.posthog.capture('subscribe_confirmed', { site: 'hub' });
        return;
      }
      if (tries++ < 50) setTimeout(tick, 100);
    }
    tick();
  })();
</script>
