---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Check your email"
  description="Confirm your email to receive the free chapter of the Indie Launch Playbook."
  canonicalPath="/playbook/check-email"
  ogImage="/og-playbook.png"
>
  <section class="page-hero">
    <div class="container prose-narrow">
      <p class="margin-note">Almost there</p>
      <h1 class="hero-title" style="max-width: 12ch;">Check your email</h1>
      <p class="lede">
        We sent a confirmation link. Open it within 48 hours to get the free chapter — after confirm you will also get an early-access link on the thanks page and in the welcome email.
      </p>
      <p class="lede" style="margin-top: 0.75rem;">
        If you do not see it, check Promotions or Updates — and spam.
      </p>
      <div class="cta-row">
        <a class="btn btn-ghost" href="/playbook">Back to the playbook</a>
      </div>
    </div>
  </section>
</BaseLayout>
