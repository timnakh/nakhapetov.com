---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SubscribeForm from '../../components/SubscribeForm.astro';
import AppIntro from '../../components/AppIntro.astro';
import RouteMap from '../../components/RouteMap.astro';
import EvidenceBlock from '../../components/EvidenceBlock.astro';
import { playbook } from '../../data/playbook';

const showBuy = Boolean(playbook.checkoutUrl);

// ?error= is filled at request time by functions/_middleware.ts (static build has no searchParams).
---

<BaseLayout
  title="The Indie Launch Playbook"
  description="From vibe-coded app to paid product: web payments, Google Play, subscriptions and an AI Pack. The route in order, with every wrong turn marked."
  canonicalPath="/playbook"
  ogImage="/og-playbook.png"
  turnstile
>
  <section class="page-hero">
    <div class="container">
      <p class="margin-note">Free chapter · Updated Nov 2026</p>
      <h1 class="hero-title" data-word-reveal style="font-size: clamp(2.2rem, 6vw, 4rem); max-width: 16ch;">
        From vibe-coded app to paid product
      </h1>
      <p class="lede">
        Web payments, Google Play, subscriptions and an AI Pack. The route in order, with every wrong turn marked.
      </p>
      <p class="form-status is-error" role="alert" data-subscribe-error-slot hidden></p>
      <p class="form-status is-ok" role="status" data-chapter-link-sent-slot hidden></p>
      <div style="margin-top: 2rem;">
        <SubscribeForm id="subscribe" />
      </div>
      <div class="chapter-resend" style="margin-top: 1.5rem; max-width: 36rem;">
        <p class="hint" style="margin-bottom: 0.75rem;">
          Already confirmed? Enter the same email — if it is subscribed, I will send your chapter link again.
        </p>
        <form
          id="chapter-link-resend"
          class="subscribe-form"
          method="POST"
          action="/api/chapter-link"
          data-analytics="subscribe"
          data-subscribe-event="chapter_link_resend"
          data-turnstile-form
        >
          <label class="sr-only" for="chapter-link-email">Email</label>
          <div class="row">
            <input
              id="chapter-link-email"
              type="email"
              name="email"
              required
              autocomplete="email"
              inputmode="email"
              placeholder="you@example.com"
            />
            <div class="hp" aria-hidden="true">
              <label for="chapter-link-company">Company</label>
              <input
                id="chapter-link-company"
                type="text"
                name="company"
                tabindex="-1"
                autocomplete="off"
              />
            </div>
            <button class="btn btn-ghost" type="submit" data-subscribe-submit>
              Resend my link
            </button>
          </div>
          <div
            class="cf-turnstile"
            data-sitekey=""
            data-theme="light"
            data-size="flexible"
          >
          </div>
          <p class="turnstile-hint" data-turnstile-hint hidden>
            Complete the check above to enable submit.
          </p>
        </form>
      </div>
      {
        showBuy && (
          <div class="cta-row">
            <a class="btn btn-ghost" href={playbook.checkoutUrl}>
              Buy the full edition
            </a>
          </div>
        )
      }
    </div>
  </section>

  <AppIntro />

  <RouteMap />

  <EvidenceBlock page="playbook" />

  <section class="section" aria-labelledby="why-heading">
    <div class="container">
      <h2 class="section-title" id="why-heading">Why it exists</h2>
      <p class="section-lede">
        I took one app from working code to payments on the web and on Google Play. This playbook is that route in order, written after doing it, with the mistakes left in.
      </p>
    </div>
  </section>

  <section class="section" aria-labelledby="inside-heading">
    <div class="container">
      <h2 class="section-title" id="inside-heading">What's inside</h2>
      <div class="stats">
        {
          playbook.stats.map((stat) => (
            <div class="stat">
              <div class="stat-value">{stat.value}</div>
              <div class="stat-label">{stat.label}</div>
              {'note' in stat && stat.note ? <p class="stat-note">{stat.note}</p> : null}
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="ai-pack-heading">
    <div class="container prose-narrow">
      <h2 class="section-title" id="ai-pack-heading">The AI Pack</h2>
      <p>
        A Markdown file you drop into your AI coding tool: operating rules, 14 copy-and-paste briefs and a guide mode. Your keys, logins and payments stay with you.
      </p>
    </div>
  </section>

  <section class="section" aria-labelledby="limits-heading">
    <div class="container prose-narrow">
      <h2 class="section-title" id="limits-heading">Honest limits</h2>
      <p>
        Platform rules change, so every claim is dated. The playbook does not cover Apple's App Store or tax advice.
      </p>
    </div>
  </section>

  <section class="section" aria-labelledby="faq-heading">
    <div class="container" style="max-width: 40rem;">
      <h2 class="section-title" id="faq-heading">FAQ</h2>
      <div class="faq">
        {
          playbook.faq.map((item) => (
            <details>
              <summary>{item.q}</summary>
              <p>{item.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="again-heading">
    <div class="container">
      <h2 class="section-title" id="again-heading">Get the free chapter</h2>
      <p class="form-status is-error" role="alert" data-subscribe-error-slot hidden></p>
      <p class="form-status is-ok" role="status" data-chapter-link-sent-slot hidden></p>
      <SubscribeForm id="subscribe-footer" />
      <p class="hint" style="margin-top: 1rem;">
        Already on the list? Use <a href="#subscribe">Resend my link</a> above.
      </p>
      {
        showBuy && (
          <div class="cta-row">
            <a class="btn btn-ghost" href={playbook.checkoutUrl}>
              Buy the full edition
            </a>
          </div>
        )
      }
      <div class="early-access-cta">
        <p>
          The full playbook and the AI Pack are written. I am checking demand before I open sales.
        </p>
        <div class="cta-row">
          <a
            class="btn btn-ghost"
            href="/playbook/early-access"
            data-event="early_access_click"
            data-source="playbook"
          >
            Get early access to the full playbook
          </a>
        </div>
      </div>
      <p class="edition">Edition: {playbook.edition}</p>
    </div>
  </section>
</BaseLayout>
