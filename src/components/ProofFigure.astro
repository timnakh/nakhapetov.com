---
import type { ProofSources } from '../data/proof';

interface Props {
  src: string | null;
  sources?: ProofSources | null;
  alt: string;
  caption: string;
  figNumber: number;
  missing?: boolean;
  width?: number;
  height?: number;
}

const {
  src,
  sources = null,
  alt,
  caption,
  figNumber,
  missing = false,
  width = 960,
  height = 600,
} = Astro.props;

const fullCaption = `Fig. ${figNumber}. ${caption}`;
const lightboxSrc = sources?.fallback ?? src;
---

<figure class="proof-figure" data-proof-figure>
  {
    lightboxSrc && !missing ? (
      <button
        type="button"
        class="proof-thumb"
        data-lightbox-open
        data-lightbox-src={lightboxSrc}
        data-lightbox-alt={alt}
        aria-label={`Enlarge: ${alt}`}
      >
        <picture>
          {sources?.avif && <source srcset={sources.avif} type="image/avif" />}
          {sources?.webp && <source srcset={sources.webp} type="image/webp" />}
          <img
            src={lightboxSrc}
            alt={alt}
            width={width}
            height={height}
            loading="lazy"
            decoding="async"
          />
        </picture>
      </button>
    ) : (
      <div class="shot-slot" role="img" aria-label={`${alt} — asset pending`}>
        <span class="shot-label">asset pending · dev only</span>
      </div>
    )
  }
  <figcaption class="fig-cap">{fullCaption}</figcaption>
</figure>
