---
import type { Project } from '../data/projects';

interface Props {
  project: Project;
  index: number;
}

const { project, index } = Astro.props;
const hasBadgeFile = Boolean(project.playStore?.badgeSrc);
const num = String(index + 1).padStart(2, '0');
---

{
  project.featuredWorld ? (
    <article class="lj-world" data-project={project.id}>
      <span class="stamp">Live</span>
      <p class="meta" style="font-family: var(--font-mono); font-size: 0.75rem; margin: 0 0 0.5rem;">
        {num} · {project.year} · {project.status}
      </p>
      <h3>{project.name}</h3>
      <p>{project.description}</p>
      <div class="lj-frame" aria-hidden={project.image ? undefined : true}>
        {project.image ? (
          <img src={project.image} alt={project.imageAlt ?? ''} loading="lazy" width="640" height="400" />
        ) : (
          <span class="shot-label">screenshot pending</span>
        )}
      </div>
      <p class="fig-cap" style="color: var(--lj-muted);">
        Fig. 1. Life Journey RPG — app world (asset pending).
      </p>
      <div class="project-actions">
        <a
          class="btn btn-primary"
          href={project.cta.href}
          data-event="project_card_click"
          data-project={project.id}
          {...(project.cta.href.startsWith('http')
            ? { rel: 'noopener noreferrer', target: '_blank' }
            : {})}
        >
          {project.cta.label}
        </a>
        {project.playStore && (
          <a
            class={hasBadgeFile ? 'play-badge' : 'play-badge-fallback'}
            href={project.playStore.href}
            rel="noopener noreferrer"
            target="_blank"
            data-event="play_store_click"
            data-source="hub"
            aria-label="Get it on Google Play"
          >
            {hasBadgeFile ? (
              <img
                src={project.playStore.badgeSrc}
                alt="Get it on Google Play"
                height="40"
                width="135"
              />
            ) : (
              <span>Get it on Google Play</span>
            )}
          </a>
        )}
      </div>
    </article>
  ) : (
    <tr class="project-row" data-project={project.id}>
      <td>
        <a
          class="row-link"
          href={project.cta.href}
          data-event="project_card_click"
          data-project={project.id}
          {...(project.cta.href.startsWith('http')
            ? { rel: 'noopener noreferrer', target: '_blank' }
            : {})}
        >
          <span class="meta">{num}</span>
        </a>
      </td>
      <td>
        <a
          class="row-link"
          href={project.cta.href}
          data-event="project_card_click"
          data-project={project.id}
          {...(project.cta.href.startsWith('http')
            ? { rel: 'noopener noreferrer', target: '_blank' }
            : {})}
        >
          <span class="name">{project.name}</span>
          <span class="desc">{project.description}</span>
        </a>
      </td>
      <td>
        <span class="meta">{project.status}</span>
      </td>
      <td class="col-year">
        <span class="meta">{project.year}</span>
      </td>
      <td>
        <a
          class="row-link arrow"
          href={project.cta.href}
          data-event="project_card_click"
          data-project={project.id}
          aria-label={project.cta.label}
          {...(project.cta.href.startsWith('http')
            ? { rel: 'noopener noreferrer', target: '_blank' }
            : {})}
        >
          →
        </a>
      </td>
    </tr>
  )
}
