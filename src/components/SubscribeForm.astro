---
/**
 * Форма «получить бесплатную главу».
 * Работает без JS: обычный POST + редирект со стороны Functions.
 */
interface Props {
  id?: string;
  compact?: boolean;
  hint?: string;
  buttonLabel?: string;
  eventName?: string;
}

const {
  id = 'subscribe',
  compact = false,
  hint = 'One email with the chapter, one when the full edition is ready. Unsubscribe any time.',
  buttonLabel = 'Get the free chapter',
  eventName = 'subscribe_submit',
} = Astro.props;
---

<form
  id={id}
  class="subscribe-form"
  method="POST"
  action="/api/subscribe"
  data-analytics="subscribe"
  data-subscribe-event={eventName}
>
  <label class="sr-only" for={`${id}-email`}>Email</label>
  <div class="row">
    <input
      id={`${id}-email`}
      type="email"
      name="email"
      required
      autocomplete="email"
      inputmode="email"
      placeholder="you@example.com"
    />
    {/* honeypot — off-screen, hidden from AT and Tab */}
    <div class="hp" aria-hidden="true">
      <label for={`${id}-company`}>Company</label>
      <input
        id={`${id}-company`}
        type="text"
        name="company"
        tabindex="-1"
        autocomplete="off"
      />
    </div>
    <button class="btn btn-primary" type="submit">{buttonLabel}</button>
  </div>
  <div
    class="cf-turnstile"
    data-sitekey=""
    data-theme="light"
    data-size="flexible"
  >
  </div>
  {!compact && <p class="hint">{hint}</p>}
</form>

<script>
  const key = document.body.dataset.turnstileSiteKey || '';
  document.querySelectorAll('.cf-turnstile').forEach((el) => {
    if (key) el.setAttribute('data-sitekey', key);
    else el.remove();
  });
</script>
