---
/**
 * Форма «получить бесплатную главу».
 * Работает без JS: обычный POST + редирект со стороны Functions.
 * Site key: PUBLIC_TURNSTILE_SITE_KEY на сборке и/или runtime-инъекция в _middleware.
 */
interface Props {
  id?: string;
  compact?: boolean;
  hint?: string;
  buttonLabel?: string;
  eventName?: string;
}

const {
  id = 'subscribe',
  compact = false,
  hint = 'One email with the chapter. After confirm you can signal demand for the full playbook. Unsubscribe any time.',
  buttonLabel = 'Get the free chapter',
  eventName = 'subscribe_submit',
} = Astro.props;

const siteKey = (import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? '').trim();
---

<form
  id={id}
  class="subscribe-form"
  method="POST"
  action="/api/subscribe"
  data-analytics="subscribe"
  data-subscribe-event={eventName}
  data-turnstile-form
>
  <label class="sr-only" for={`${id}-email`}>Email</label>
  <div class="row">
    <input
      id={`${id}-email`}
      type="email"
      name="email"
      required
      autocomplete="email"
      inputmode="email"
      placeholder="you@example.com"
    />
    {/* honeypot — off-screen, hidden from AT and Tab */}
    <div class="hp" aria-hidden="true">
      <label for={`${id}-company`}>Company</label>
      <input
        id={`${id}-company`}
        type="text"
        name="company"
        tabindex="-1"
        autocomplete="off"
      />
    </div>
    <button class="btn btn-primary" type="submit" data-subscribe-submit>
      {buttonLabel}
    </button>
  </div>
  <div
    class="cf-turnstile"
    data-sitekey={siteKey}
    data-theme="light"
    data-size="flexible"
  >
  </div>
  <p class="turnstile-hint" data-turnstile-hint hidden>
    Complete the check above to enable submit.
  </p>
  {!compact && <p class="hint">{hint}</p>}
</form>
