---
/**
 * Форма «получить бесплатную главу».
 * Работает без JS: обычный POST + редирект со стороны Functions.
 */
interface Props {
  id?: string;
  compact?: boolean;
}

const { id = 'subscribe', compact = false } = Astro.props;
---

<form
  id={id}
  class="subscribe-form"
  method="POST"
  action="/api/subscribe"
  data-analytics="subscribe"
>
  <label class="sr-only" for={`${id}-email`}>Email</label>
  <div class="row">
    <input
      id={`${id}-email`}
      type="email"
      name="email"
      required
      autocomplete="email"
      inputmode="email"
      placeholder="you@example.com"
    />
    {/* honeypot — боты заполняют, люди не видят */}
    <label class="hp" aria-hidden="true">
      Company
      <input type="text" name="company" tabindex="-1" autocomplete="off" />
    </label>
    <button class="btn btn-primary" type="submit">Get the free chapter</button>
  </div>
  <div
    class="cf-turnstile"
    data-sitekey=""
    data-theme="light"
    data-size="flexible"
  >
  </div>
  {
    !compact && (
      <p class="hint">
        One email with the chapter, one when the full edition is ready. Unsubscribe any time.
      </p>
    )
  }
</form>

<script>
  // Подставляем site key из data-атрибута body (PUBLIC_TURNSTILE_SITE_KEY)
  const key = document.body.dataset.turnstileSiteKey || '';
  document.querySelectorAll('.cf-turnstile').forEach((el) => {
    if (key) el.setAttribute('data-sitekey', key);
    else el.remove();
  });
</script>
