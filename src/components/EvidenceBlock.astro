---
import ProofFigure from './ProofFigure.astro';
import { resolveProofForPage } from '../data/proof';

interface Props {
  page?: 'playbook' | 'chapter-1';
  headingId?: string;
}

const { page = 'playbook', headingId = 'evidence-heading' } = Astro.props;
const shots = resolveProofForPage(page);
---

{
  shots.length > 0 && (
    <section class="section" aria-labelledby={headingId} id="evidence">
      <div class="container">
        <p class="margin-note">Proof · screenshots</p>
        <h2 class="section-title" id={headingId}>
          Evidence
        </h2>
        <div class="evidence-grid">
          {shots.map((shot, i) => (
            <ProofFigure
              src={shot.src}
              alt={shot.alt}
              caption={shot.caption}
              figNumber={i + 1}
              missing={shot.missing}
            />
          ))}
        </div>
      </div>
    </section>
  )
}

<dialog class="lightbox" data-lightbox>
  <form method="dialog" class="lightbox-close-row">
    <button type="submit" class="btn btn-ghost" aria-label="Close">
      Close
    </button>
  </form>
  <img data-lightbox-img alt="" width="1200" height="800" />
</dialog>
