---
interface Props {
  items: string[];
}
const { items } = Astro.props;
---

<div class="done-when" data-done-when>
  <p class="margin-note">Done when</p>
  <ul class="done-list">
    {
      items.map((item, i) => (
        <li>
          <label>
            <input type="checkbox" name={`done-${i}`} />
            <span>{item}</span>
          </label>
        </li>
      ))
    }
  </ul>
</div>
