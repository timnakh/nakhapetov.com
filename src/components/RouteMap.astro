---
import { routeStations } from '../data/route';
import { milestones } from '../data/log';

/** Координаты станций вдоль SVG-тропы (viewBox 0 0 640 280) */
const points = [
  { x: 36, y: 48 },
  { x: 120, y: 160 },
  { x: 210, y: 72 },
  { x: 310, y: 200 },
  { x: 400, y: 88 },
  { x: 500, y: 180 },
  { x: 600, y: 56 },
];

const pathD = points
  .map((p, i) => `${i === 0 ? 'M' : 'L'} ${p.x} ${p.y}`)
  .join(' ');
---

<section class="section" aria-labelledby="route-heading">
  <div class="container">
    <p class="margin-note">Field notes · real dates</p>
    <h2 class="section-title" id="route-heading">The route</h2>

    <div class="route-layout">
      <div>
        <h3 class="eyebrow" style="margin-bottom: 0.75rem;">Milestone log</h3>
        <ol class="milestone-log">
          {
            milestones.map((m) => (
              <li>
                <span class="milestone-date">{m.date}</span>
                <span class="milestone-event">{m.event}</span>
              </li>
            ))
          }
        </ol>
      </div>

      <div class="route" data-route>
        <div class="route-svg-wrap">
          <svg
            class="route-svg"
            viewBox="0 0 640 280"
            role="img"
            aria-label="Metro-style map of the seven playbook stations"
          >
            <path class="route-track" d={pathD}></path>
            <path class="route-track-draw" d={pathD}></path>
            {
              routeStations.map((node, i) => {
                const p = points[i];
                return (
                  <g
                    class="route-station"
                    data-route-node
                    data-step={node.id}
                    tabindex="0"
                    role="button"
                    aria-expanded="false"
                    aria-label={`${node.title}. ${node.trap}`}
                  >
                    <circle cx={p.x} cy={p.y} r="9"></circle>
                    <text x={p.x} y={p.y - 18} text-anchor="middle">
                      {String(node.id).padStart(2, '0')} {node.title}
                    </text>
                  </g>
                );
              })
            }
          </svg>
        </div>

        <ul class="route-list-mobile">
          {
            routeStations.map((node) => (
              <li>
                <button
                  type="button"
                  data-route-node
                  data-step={node.id}
                  aria-expanded="false"
                >
                  <span class="dot" aria-hidden="true" />
                  <span>
                    <span class="label">
                      {String(node.id).padStart(2, '0')} · {node.title}
                    </span>
                    <span class="detail">
                      <span class="trap-mark">{node.trap}</span>
                      <br />
                      {node.tip} ·{' '}
                      <a href={node.chapterHref}>Open chapter</a>
                    </span>
                  </span>
                </button>
              </li>
            ))
          }
        </ul>

        <div class="route-panel" data-route-panel hidden>
          <p class="trap-mark" data-route-trap></p>
          <p class="tip" data-route-tip></p>
          <a class="btn btn-ghost" data-route-link href="#">Open chapter</a>
        </div>

        <script is:inline define:vars={{ stations: routeStations }}>
          window.__ROUTE_STATIONS__ = stations;
        </script>
      </div>
    </div>
  </div>
</section>
